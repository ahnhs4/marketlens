# Copy to .env (scripts/setup.sh does this). Never commit real keys.
# Every key is optional: a missing key disables only that feature and the UI says so.

# --- core -------------------------------------------------------------
APP_ENV=development
# Required when APP_ENV=production
SECRET_KEY=change-me
# true = sign-in required (multi-user); false = single local user
AUTH_REQUIRED=false
CORS_ORIGINS=http://localhost:3000
# Default is SQLite in backend/data/. For PostgreSQL uncomment:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/marketlens
# Empty = in-process cache. Example: redis://localhost:6379/0
REDIS_URL=

# --- data providers -----------------------------------------------------
# FRED API key (free: https://fred.stlouisfed.org/docs/api/api_key.html). Empty = FRED public CSV endpoint.
MACRO_API_KEY=
# Finnhub key (optional extra company/general news)
NEWS_API_KEY=
# SEC asks API users to identify themselves with a contact e-mail
SEC_USER_AGENT=MarketLens/0.1 your-email@example.com
# Optional: OpenFIGI key (CUSIP -> ticker for the 13F page; works without one, just slower)
OPENFIGI_API_KEY=
# OpenDART key (free: https://opendart.fss.or.kr) - Korean financial statements, dividends, value-up analysis
DART_API_KEY=

# --- AI news analysis ----------------------------------------------------
# Anthropic API key. Empty = transparent rule-based classifier (labeled "rules" in the UI)
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# --- alert delivery (optional) -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
